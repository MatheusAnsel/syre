# Copie para .env antes de rodar `docker compose up --build`.
# Gere um segredo com: openssl rand -hex 48
JWT_SECRET=

# Senha do banco usado só dentro do compose (opcional; o padrão serve para desenvolvimento).
POSTGRES_PASSWORD=syre_dev

# Administrador criado na subida da API (mínimo de 8 caracteres na senha).
# Atenção: a cada subida a senha do administrador volta para o valor daqui.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=
