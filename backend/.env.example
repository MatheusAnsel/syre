PORT=3001
# Local: postgres do seu ambiente de dev
# Produção (Supabase): use a "Connection string" do painel do projeto
# (Project Settings > Database), modo "Transaction pooler" — porta 6543
DATABASE_URL=postgresql://postgres:password@localhost:5432/syre
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Gere um valor aleatório forte, ex: openssl rand -base64 48
JWT_SECRET=

# Usados apenas ao rodar `npm run create-admin` (não usados pelo servidor)
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=

# Conta de demonstração SOMENTE LEITURA para recrutadores (perfil 'demo'). Opcional.
# O frontend preenche o login com recrutador@syre.dev / demo-syre-2026 (VITE_DEMO_EMAIL / VITE_DEMO_SENHA).
# Estas credenciais são públicas de propósito: o perfil 'demo' não consegue gravar nada.
DEMO_NOME=Recrutador (demo)
DEMO_EMAIL=recrutador@syre.dev
DEMO_SENHA=demo-syre-2026
