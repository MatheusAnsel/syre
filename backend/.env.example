PORT=3001
# Local: postgres do seu ambiente de dev
# Produção (Supabase): use a "Connection string" do painel do projeto
# (Project Settings > Database), modo "Transaction pooler" — porta 6543
DATABASE_URL=postgresql://postgres:password@localhost:5432/syre
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Gere um valor aleatório forte, ex: openssl rand -base64 48
JWT_SECRET=

# Usados apenas ao rodar `npm run create-admin` (não usados pelo servidor)
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=
